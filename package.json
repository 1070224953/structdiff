{
  "name": "structdiff",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Semantic diff for structured data — understand what actually changed in JSON and YAML",
  "repository": "https://github.com/1070224953/structdiff",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "vite build --base ./ && electron .",
    "electron:build": "vite build --base ./ && electron-builder --win portable",
    "pages:build": "vite build --base /structdiff/ && rm -rf docs && cp -r dist docs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.structdiff.app",
    "productName": "StructDiff",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "StructDiff.exe"
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
